# macOS / Windows / Linux desktop clutter
.DS_Store
Thumbs.db
desktop.ini
*~

# Editors
.vscode/
.idea/
*.swp

# Node (not required to run this site, but ignored if you ever add tooling)
node_modules
npm-debug.log*
yarn-error.log*
package-lock.json

# Build and temp output
dist/
build/
tmp/
*.log

# Local student data exports (never commit a student's progress file)
*progress*.json

# Environment files (vercel env pull writes .env.local); keys live in Vercel only
.env
.env.*
.vercel

# Python bytecode from the build tools
__pycache__/
*.pyc

# Test output
tests/overlap-report.json
# the build scripts are source; only their download cache is ignored
!tools/build/
tools/build/.cache/

# Private master resources. Keep them outside this public repository; if a
# local copy is ever placed here for the preview builder, it is never committed.
private/
masters/
*.master.*

# Proprietary handbooks: never stored in the repository, in any folder and under any
# name, whether PDF, Word or e-book. tools/upsc/build_upsc.py reads them from a private
# folder outside the repository and writes only the chosen preview pages, as images.
# The ten public carousel PDFs are the one exception (tests/library.mjs checks both).
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[oO][dD][tT]
*.[eE][pP][uU][bB]
!/assets/carousels/economics-in-60-seconds-[0-9][0-9][0-9].pdf
/private/
